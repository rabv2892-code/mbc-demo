# Copier vers .env et remplacer toutes les valeurs d'exemple.
# Ne commitez jamais .env.

# Local : docker compose (port uniquement sur 127.0.0.1)
# Production : utilisateur/mot de passe distincts, jamais mbc_dev_password
POSTGRES_USER="mbc"
POSTGRES_PASSWORD="mbc_dev_password"
POSTGRES_DB="mbc"
DATABASE_URL="postgresql://mbc:mbc_dev_password@127.0.0.1:55434/mbc?schema=public"

# Secret JWT unique, au moins 32 caractères. Interdit : valeurs d'exemple.
JWT_SECRET="REMPLACER_PAR_UN_SECRET_UNIQUE_D_AU_MOINS_32_CARACTERES"

APP_TZ="Africa/Conakry"
COOKIE_NAME="mbc_token"
NEXT_PUBLIC_APP_NAME="Marouane Business Center"

# production = contrôles stricts ; demo = instance publique temporaire (Render)
# MBC_ENV="production"
# MBC_ENV="demo"

# Premier Super Admin (uniquement si aucun Super Admin n'existe encore)
# Interdit : emails @mbc.local et mots de passe de développement local
# ADMIN_EMAIL="admin@exemple.com"
# ADMIN_PASSWORD="mot-de-passe-long-et-unique"

# Données fictives (ventes/achats d'exemple), sans copier la base locale
# SEED_FIXTURE_DATA="true"

# Port fourni par l'hébergeur (Render définit PORT tout seul)
# PORT="3000"

# Comptes locaux (jamais en production ni sur une URL publique).
# À définir dans .env uniquement. Interdit : @mbc.local et mots de passe d'exemple.
# LOCAL_ADMIN_EMAIL=""
# LOCAL_ADMIN_PASSWORD=""
# LOCAL_SELLER_EMAIL=""
# LOCAL_SELLER_PASSWORD=""
# LOCAL_RIDER_EMAIL=""
# LOCAL_RIDER_PASSWORD=""
# ALLOW_DEMO_ACCOUNTS="true"
